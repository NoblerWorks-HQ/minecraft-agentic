# Minecraft Server
MC_HOST=localhost
MC_PORT=25565
# Minecraft version for the server AND the bots. Leave at 1.20.1 - it's the version
# the browser viewer supports exactly (other versions can render wrong blocks).
# MC_VERSION=1.20.1
# Single-agent bot name. If you change this, run `npm run ops -- <name>` and restart the
# server (or `op <name>` in the server console) so the bot has permission to build.
MC_USERNAME=BuilderBot

# ---------------------------------------------------------------------------
# AI backend - which model designs the builds.
# You need NONE of these to start: with no key, the crew builds from the free
# built-in library. Add ONE key to build your own prompts.
#
# LLM_PROVIDER is auto-detected from whichever key you set below. Set it
# explicitly (claude | gemini | openai | ollama | library) only to override.
# ---------------------------------------------------------------------------
LLM_PROVIDER=

# Google Gemini - has a FREE tier, recommended for most people.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google takes free-tier models away without warning, and it happens per-MODEL, not per-key:
# a model can 503 "high demand" for hours, get closed to new keys, or carry a free quota of 0
# while your key answers fine on another one. So a Gemini call tries this model first and then
# falls through a list of known-good fallbacks until one answers - you don't have to babysit it.
# GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude - highest quality (paid). https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI (paid). https://platform.openai.com/
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none   # GPT-5+/o-series only; "minimal" for older GPT-5 models

# Ollama - fully local, no key, but needs a real GPU and quality varies.
# Install from https://ollama.com, run `ollama serve`, then set LLM_PROVIDER=ollama.
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434
# The critic has to SEE the build, and llama3.1 has no eyes. Name a multimodal
# model here (e.g. llava) or the visual review is skipped on Ollama.
# OLLAMA_VISION_MODEL=

# Force a specific library build for the no-key demo
# (castle | wizardTower | cottage | lighthouse | windmill | pagoda | ship | temple | observatory
#  | mushroomHouse | treehouse | balloon | rocket)
# LIBRARY_BUILD=

# ---------------------------------------------------------------------------
# How hard the crew checks its own work after a build.
# ---------------------------------------------------------------------------
# REPAIR (default on): re-place blocks that never landed, and - if a block still
# won't stay - show the model WHY the game refused it and let it patch the design.
# `off` keeps the free re-placement pass but never spends a model call on it.
# REPAIR=

# CRITIC (default off): after the build, photograph it in a headless browser and
# show the pictures to a vision model next to its own blueprint, then apply the
# patch it hands back. Costs one vision call per build and needs Playwright
# (npx playwright install chromium). The web panel has a per-build checkbox for
# this - set CRITIC=on to make it the default everywhere (npm run play, demo...).
# CRITIC=
# How long the critic's browser waits for chunks to stream in before it shoots.
# SHOT_SETTLE_MS=12000

# FEWSHOT (default on): show the model a matching preset from the library as a
# worked example (~5k tokens per build). `off` sends the prompt bare.
# FEWSHOT=

# Run a different crew entirely - a directory of role JSON files (see src/profiles/).
# PROFILES_DIR=

# Browser viewer (watch the build at http://localhost:PORT - no Minecraft client needed)
# Change the port if 3000 is taken. Set VIEWER=off (or pass --no-viewer) to disable it.
VIEWER_PORT=3000
VIEWER=

# Web control panel (`npm run web`) - the interactive prompt+watch page. Port only.
WEB_PORT=8080
