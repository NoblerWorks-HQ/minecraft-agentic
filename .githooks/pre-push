#!/usr/bin/env bash
# Runs the CI gate before code leaves the machine. GENERATED - canonical source
# is engineering-standards/scripts/templates/pre-push. See scripts/check-ci-local.mjs
# for why this exists and what it covers.
#
# PRE-PUSH, not pre-commit, on purpose: we commit straight to main/master, often
# many times an hour. A per-commit gate gets bypassed by the end of the first
# afternoon; the push boundary runs it once per batch, when the work becomes
# everyone else's problem.
#
# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
Z="0000000000000000000000000000000000000000"

range=""
pushed=""
while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$Z" ] && continue                 # branch deletion, nothing to check
    pushed="$lsha"
    [ "$rsha" = "$Z" ] || range="${rsha}..${lsha}" # new branch => empty => check everything
    break
done

command -v node >/dev/null 2>&1 || {
    echo "[local-ci] UNCHECKED: node not on PATH - refusing to report a pass." >&2; exit 1; }

# The pushed sha lets the gate refuse its pass cache when the commit being
# pushed is not the checkout it is about to test.
exec node "$ROOT/scripts/check-ci-local.mjs" "$range" "$pushed"
